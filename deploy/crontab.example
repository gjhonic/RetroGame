# Крон-задачи RetroGame. Установка на сервере: crontab -u retrogame -e,
# вставить нужные строки (пути и DEPLOY_PATH подставить свои).
#
# current — тот же симлинк, что переключает деплой (deploy/activate-release.sh),
# так что крону не нужно ничего знать про релизы — он всегда видит свежий код.
#
# Каждый запуск фиксируется в БД и логируется в var/log/cron/ — см. модуль
# "Кроны" в админке (/admin/cron-runs, App\EventListener\CronTrackingListener).

# Импорт игр из Steam — раз в час, порциями по 20 штук.
0 * * * * /usr/bin/php /var/www/retrogame/current/bin/console app:games:import --limit=20 --env=prod >> /var/www/retrogame/shared/var/log/cron-games-import.log 2>&1

# Импорт цен игр из Steam (регион RU) — раз в 10 минут, порциями по 150 штук
# со случайной паузой 1-3 сек между запросами. Порция со средней паузой ~2 с
# и самими запросами к Steam реально занимает ~6 минут — интервал в 10 минут
# даёт запас, чтобы соседние запуски не пересекались (команда не защищена
# локом от параллельного запуска). В каталоге ~90 тыс. игр, так что полный
# круг обновления цен занимает несколько дней — это ожидаемо, курсор идёт по
# убыванию популярности игры (см. PriceImportService), так что в первую
# очередь обновляются цены у игр, которые реально смотрят пользователи.
*/10 * * * * /usr/bin/php /var/www/retrogame/current/bin/console app:games:import-prices --limit=150 --min-delay-ms=1000 --max-delay-ms=3000 --env=prod >> /var/www/retrogame/shared/var/log/cron-games-import-prices.log 2>&1
