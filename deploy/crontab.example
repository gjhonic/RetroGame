# Крон-задачи RetroGame. Установка на сервере: crontab -u retrogame -e,
# вставить нужные строки (пути и DEPLOY_PATH подставить свои).
#
# current — тот же симлинк, что переключает деплой (deploy/activate-release.sh),
# так что крону не нужно ничего знать про релизы — он всегда видит свежий код.
#
# Каждый запуск фиксируется в БД и логируется в var/log/cron/ — см. модуль
# "Кроны" в админке (/admin/cron-runs, App\EventListener\CronTrackingListener).

# --- Импорт каталога (наличие игр) — раз в час, по 100 штук, Steam и Plati
# запускаются в разные минуты часа, чтобы не пересекаться друг с другом
# (обе команды не защищены локом от параллельного запуска, а даже без
# конфликта данных незачем гонять два внешних API одновременно с одного
# сервера). При лимите 100 и текущих задержках между запросами обе
# укладываются в единицы минут — получасовой сдвиг между ними с большим
# запасом.

# Импорт игр из Steam — минута 0 каждого часа.
0 * * * * /usr/bin/php /var/www/retrogame/current/bin/console app:games:import --limit=100 --env=prod >> /var/www/retrogame/shared/var/log/cron-games-import.log 2>&1

# Проверка наличия игр на plati.market — минута 30 каждого часа (полчаса
# после Steam, см. пояснение выше). Источник — публичный JSON Web API
# Digiseller (api.digiseller.ru/api/products/search2, owner=1 —
# plati.market), не HTML-скрапинг: запросы не требуют браузерного
# контекста и не упираются в антибот-защиту (см. Service\Plati\PlatiClient
# — там же объяснение, почему изначально предполагавшийся ggsel.net для
# этого не подошёл, там Qrator). Курсор идёт по убыванию популярности игры
# (см. Service\Plati\GameImportService) и не сбрасывается по дням: обход
# пропускает игры, для которых уже есть найденная ссылка (PlatiGame),
# поэтому круг по каталогу естественным образом ускоряется со временем, а
# к не найденным ранее играм обход возвращается сам, когда доходит до
# конца списка.
30 * * * * /usr/bin/php /var/www/retrogame/current/bin/console app:games:import-plati --limit=100 --delay-ms=500 --env=prod >> /var/www/retrogame/shared/var/log/cron-games-import-plati.log 2>&1

# --- Импорт цен — раз в 10 минут, по 100 штук, Steam и Plati запускаются
# со сдвигом в 5 минут друг относительно друга по той же причине, что и
# выше (плюс Steam-импорт реально занимает ~4 минуты — без сдвига он мог
# бы пересечься со следующим запуском Plati в ту же минуту).

# Импорт цен игр из Steam (регион RU) — минуты 0,10,20,30,40,50, порциями
# по 100 штук со случайной паузой 1-3 сек между запросами. Порция со
# средней паузой ~2 с и самими запросами к Steam реально занимает ~4
# минуты — интервал в 10 минут даёт запас, чтобы соседние запуски не
# пересекались. Курсор идёт по убыванию популярности игры (см.
# PriceImportService) и каждый день сбрасывается на начало списка: при
# ~90 тыс. игр в каталоге пройти его целиком за сутки всё равно не успеть,
# а так цены у самых популярных игр обновляются каждый день, а не раз в
# несколько дней, когда докрутится очередь. Игры, до которых очередь за
# день не дошла, остаются без свежего снимка — это ожидаемо.
*/10 * * * * /usr/bin/php /var/www/retrogame/current/bin/console app:games:import-prices --limit=100 --min-delay-ms=1000 --max-delay-ms=3000 --env=prod >> /var/www/retrogame/shared/var/log/cron-games-import-prices.log 2>&1

# Импорт цен игр на plati.market — минуты 5,15,25,35,45,55 (сдвиг +5 минут
# от Steam), порциями по 100 штук, только для уже найденных игр
# (app:games:import-plati). Курсор идёт по убыванию популярности игры и
# сбрасывается каждый день (см. Service\Plati\PriceImportService) — тот же
# приём, что и у app:games:import-prices (Steam).
5-55/10 * * * * /usr/bin/php /var/www/retrogame/current/bin/console app:games:import-plati-prices --limit=100 --delay-ms=500 --env=prod >> /var/www/retrogame/shared/var/log/cron-games-import-plati-prices.log 2>&1

# Очистка промежуточных снимков цены игр — раз в неделю (по понедельникам),
# обрабатывает окно из последних 2 недель: для каждой игры внутри непрерывной
# серии одинаковой цены оставляет только первую и последнюю запись (цену до
# и после изменения), остальные снимки удаляет.
0 3 * * 1 /usr/bin/php /var/www/retrogame/current/bin/console app:games:cleanup-prices --weeks=2 --env=prod >> /var/www/retrogame/shared/var/log/cron-games-cleanup-prices.log 2>&1
