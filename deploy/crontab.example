# Крон-задачи RetroGame. Установка на сервере: crontab -u retrogame -e,
# вставить нужные строки (пути и DEPLOY_PATH подставить свои).
#
# current — тот же симлинк, что переключает деплой (deploy/activate-release.sh),
# так что крону не нужно ничего знать про релизы — он всегда видит свежий код.
#
# Каждый запуск фиксируется в БД и логируется в var/log/cron/ — см. модуль
# "Кроны" в админке (/admin/cron-runs, App\EventListener\CronTrackingListener).

# Импорт игр из Steam — раз в час, порциями по 20 штук.
0 * * * * /usr/bin/php /var/www/retrogame/current/bin/console app:games:import --limit=20 --env=prod >> /var/www/retrogame/shared/var/log/cron-games-import.log 2>&1

# Импорт цен игр из Steam (регион RU) — раз в 10 минут, порциями по 100 штук
# со случайной паузой 1-3 сек между запросами. Порция со средней паузой ~2 с
# и самими запросами к Steam реально занимает ~4 минуты — интервал в 10 минут
# даёт запас, чтобы соседние запуски не пересекались (команда не защищена
# локом от параллельного запуска). Курсор идёт по убыванию популярности игры
# (см. PriceImportService) и каждый день сбрасывается на начало списка: при
# ~90 тыс. игр в каталоге пройти его целиком за сутки всё равно не успеть, а
# так цены у самых популярных игр обновляются каждый день, а не раз в
# несколько дней, когда докрутится очередь. Игры, до которых очередь за день
# не дошла, остаются без свежего снимка — это ожидаемо.
*/10 * * * * /usr/bin/php /var/www/retrogame/current/bin/console app:games:import-prices --limit=100 --min-delay-ms=1000 --max-delay-ms=3000 --env=prod >> /var/www/retrogame/shared/var/log/cron-games-import-prices.log 2>&1

# Очистка промежуточных снимков цены игр — раз в неделю (по понедельникам),
# обрабатывает окно из последних 2 недель: для каждой игры внутри непрерывной
# серии одинаковой цены оставляет только первую и последнюю запись (цену до
# и после изменения), остальные снимки удаляет.
0 3 * * 1 /usr/bin/php /var/www/retrogame/current/bin/console app:games:cleanup-prices --weeks=2 --env=prod >> /var/www/retrogame/shared/var/log/cron-games-cleanup-prices.log 2>&1

# Проверка наличия игр на ggsel.net (HTML-скрапинг, публичного API нет) —
# раз в 30 минут, порциями по 20 штук с паузой 1.5 с между запросами.
# Курсор идёт по убыванию популярности игры (см. Service\Ggsel\GameImportService)
# и не сбрасывается по дням: обход пропускает игры, для которых уже есть
# найденная ссылка (GgselGame), поэтому круг по каталогу естественным
# образом ускоряется со временем, а к не найденным ранее играм обход
# возвращается сам, когда доходит до конца списка.
*/30 * * * * /usr/bin/php /var/www/retrogame/current/bin/console app:games:import-ggsel --limit=20 --delay-ms=1500 --env=prod >> /var/www/retrogame/shared/var/log/cron-games-import-ggsel.log 2>&1
