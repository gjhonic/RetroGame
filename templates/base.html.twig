<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}RetroGame{% endblock %}</title>
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon/favicon-32.png') }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon/favicon-16.png') }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('favicon/apple-touch-icon.png') }}">
        {% block stylesheets %}
            {{ reprise_entry_link_tags('app') }}
            <link rel="stylesheet" href="{{ asset('build/styles/common.css') }}">
            <link rel="stylesheet" href="{{ asset('build/styles/public/base.css') }}">
        {% endblock %}

        {% block javascripts %}
            {{ reprise_entry_script_tags('app') }}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <header class="site-header">
            <div class="container site-header__inner">
                <a href="{{ path('app_game_index') }}" class="site-logo">
                    <img src="{{ asset('favicon/favicon-64.png') }}" alt="" class="site-logo__icon">
                    RetroGame
                </a>
                <nav class="site-nav">
                    <a href="{{ path('app_game_index') }}" class="site-nav__link site-nav__link--active">Каталог</a>
                    {% if is_granted('ROLE_USER') %}
                        <a href="{{ path('cabinet_dashboard') }}" class="site-nav__link">Кабинет</a>
                        {% if is_granted('ROLE_MODERATOR') %}
                            <a href="{{ path('admin_dashboard') }}" class="site-nav__link">Админка</a>
                        {% endif %}
                        <a href="{{ path('logout') }}" class="site-nav__link">Выйти</a>
                    {% else %}
                        <a href="{{ path('login') }}" class="site-nav__link">Войти</a>
                    {% endif %}
                </nav>
            </div>
        </header>

        <main>
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="container">
                <p>RetroGame — некоммерческий справочник компьютерных игр.</p>
                <p><a href="{{ path('app.swagger_ui') }}">API</a></p>
            </div>
        </footer>
    </body>
</html>
