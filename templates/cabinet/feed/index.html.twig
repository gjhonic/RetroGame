{% extends 'cabinet/base.html.twig' %}

{% block title %}Лента — RetroGame{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('build/styles/public/game-show.css') }}">
    <link rel="stylesheet" href="{{ asset('build/styles/cabinet/game-detail.css') }}">
    <link rel="stylesheet" href="{{ asset('build/styles/cabinet/feed.css') }}">
{% endblock %}

{% block body %}
    <div class="cabinet-welcome">
        <h1 class="cabinet-welcome__title">С возвращением, {{ app.user.email }} 👋</h1>
        <p class="cabinet-welcome__subtitle">
            Здесь будет ваш игровой уголок: статьи, оценки, тир-листы и календарь релизов.
            Раздел в разработке — скоро тут появится жизнь.
        </p>
    </div>

    <div {{ vue_component('Cabinet/TakeFeed', { isAuthenticated: is_granted('ROLE_USER') }) }}></div>
{% endblock %}
