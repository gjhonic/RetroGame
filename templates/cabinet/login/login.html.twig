{% extends 'base.html.twig' %}

{% block title %}Вход — RetroGame{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('build/styles/public/login.css') }}">
{% endblock %}

{% block body %}
    {% if coverImageRows %}
        {# Без loading="lazy": ленту сразу сдвигает CSS-анимация, на узких экранах в исходной
           области видимости остаётся мало картинок — ленивая загрузка не всегда успевала
           сработать до отрисовки, из-за чего фон на мобильных иногда не показывался. #}
        <div class="auth-bg" aria-hidden="true">
            {% for row in coverImageRows %}
                <div class="auth-bg__row">
                    {% for path in row|merge(row) %}
                        <img src="{{ '/' ~ path }}" alt="">
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="container auth-page">
        <section class="street-auth-intro">
            <p class="street-eyebrow">RETROGAME / МЕСТО ВСТРЕЧ ГЕЙМЕРОВ</p>
            <h2>СВОИ ИГРЫ.<br><span>СВОИ ЛЮДИ.</span></h2>
            <p>Собирай любимые игры, отмечай пройденное<br>и делись тем, что зацепило.</p>
            <span class="street-auth-sticker" aria-hidden="true">PRESS START ↗</span>
        </section>
        <div class="auth-card">
            <p class="street-eyebrow">WELCOME BACK / СНОВА В ИГРЕ</p>
            <h1 class="auth-card__title">Вход</h1>
            <p class="auth-card__subtitle">Твой следующий уровень начинается здесь.</p>

            {% if error %}
                <p class="alert alert--error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
            {% endif %}

            <form method="post" class="auth-form">
                <div class="form-field">
                    <label for="email">Email</label>
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="email"
                        id="email"
                        autocomplete="email"
                        required
                        autofocus
                    >
                </div>

                <div class="form-field">
                    <label for="password">Пароль</label>
                    <input type="password" name="password" id="password" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn btn--primary">Войти</button>
            </form>

            <p class="auth-card__footer">
                Нет аккаунта? <a href="{{ path('app_register') }}">Зарегистрироваться</a>
            </p>
        </div>
    </div>
{% endblock %}
