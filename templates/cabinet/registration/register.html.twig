{% extends 'base.html.twig' %}

{% block title %}Регистрация — RetroGame{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('build/styles/public/login.css') }}">
{% endblock %}

{% block body %}
    {% if coverImageRows %}
        {# Без loading="lazy" — см. templates/cabinet/login/login.html.twig. #}
        <div class="auth-bg" aria-hidden="true">
            {% for row in coverImageRows %}
                <div class="auth-bg__row">
                    {% for path in row|merge(row) %}
                        <img src="{{ '/' ~ path }}" alt="">
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="container auth-page">
        <section class="street-auth-intro">
            <p class="street-eyebrow">RETROGAME / МЕСТО ВСТРЕЧ ГЕЙМЕРОВ</p>
            <h2>СВОИ ИГРЫ.<br><span>СВОИ ЛЮДИ.</span></h2>
            <p>Собирай любимые игры, отмечай пройденное<br>и делись тем, что зацепило.</p>
            <span class="street-auth-sticker" aria-hidden="true">PRESS START ↗</span>
        </section>
        <div class="auth-card" {{ vue_component('Cabinet/RegistrationForm') }}></div>
    </div>
{% endblock %}
