{% extends 'cabinet/base.html.twig' %}

{% block title %}Игра — RetroGame{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('build/styles/public/game-show.css') }}">
    <link rel="stylesheet" href="{{ asset('build/styles/cabinet/game-detail.css') }}">
{% endblock %}

{% block body %}
    <a href="{{ path('app_game_index') }}" class="back-link">← Назад в каталог</a>

    <div {{ vue_component('Cabinet/GameDetail', { slug: slug, isAuthenticated: is_granted('ROLE_USER') }) }}></div>
{% endblock %}
